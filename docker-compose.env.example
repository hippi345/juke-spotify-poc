# Loaded automatically by docker compose (see docker-compose.yml env_file).
# Copy to docker-compose.env (gitignored) only when you need local overrides.
# Never commit real Spotify credentials or production secrets.

AUTH_SECRET=change-me-local-compose-only
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REFRESH_TOKEN=
GEMINI_API_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

