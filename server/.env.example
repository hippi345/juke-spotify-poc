# =============================================================================
# TEMPLATE ONLY — the server never reads this filename. Copy to ".env":
#   cd server && cp .env.example .env
#
# PORT / Windows: If http://127.0.0.1:8080/ on Windows shows PostgreSQL/EnterpriseDB
# HTML instead of JSON {"service":"juke-spotify-poc-api"}, port 8080 on Windows is NOT
# your Go server (Go may be in WSL on 8080; the emulator uses the Windows port).
# Pick a free port and use it everywhere (server, client/.env VITE_API_URL, mobile JUKE_API_BASE):
#   PORT=8081
#
# Files named ".env" are gitignored (see repo .gitignore) — they are not pushed.
#
# GEMINI / VibeSense — pick ONE approach:
#
#   (1) Environment only (good for not storing the key in any file):
#       export GEMINI_API_KEY="your_key"
#       go run .
#       Do NOT put GEMINI_API_KEY in .env, or remove that line if present.
#       IDEs often do not inherit your shell — add GEMINI_API_KEY to the run/debug env.
#
#   (2) server/.env file (still not committed; .env is ignored by git):
#       GEMINI_API_KEY=your_key
#
# If GEMINI_API_KEY is already set in the environment, values from .env will NOT
# override it (standard godotenv behavior).
# =============================================================================

# Spotify (required for Connect Spotify)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# Google AI — VibeSense — optional here if you use export GEMINI_API_KEY instead (see above)
# GEMINI_API_KEY=

# Optional model override (default: gemini-2.5-flash). Alternatives: gemini-2.5-flash-lite, gemini-2.0-flash
# GEMINI_MODEL=gemini-2.5-flash

# Optional overrides
# SPOTIFY_REDIRECT_URI must EXACTLY match the redirect URI in your Spotify app dashboard.
# Spotify requires 127.0.0.1 (not localhost) for local dev.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/spotify/callback
# APP_BASE_URL=http://localhost:5173
