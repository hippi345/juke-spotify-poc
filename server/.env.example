# Spotify (required for Connect Spotify)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# Optional overrides
# SPOTIFY_REDIRECT_URI must EXACTLY match the redirect URI in your Spotify app dashboard.
# Spotify requires 127.0.0.1 (not localhost) for local dev.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/spotify/callback
# APP_BASE_URL=http://localhost:5173
